{
  "workspace": [
    "./examples",
    "./kz/internal",
    "./kz/core",
    "./kz/logging",
    "./kz/pattern",
    "./kz/util",
    "./kz/testing",
    "./kz/warn"
  ],
  "importMap": "./import_map.json",
  "tasks": {
    "cov": {
      "description": "Run all coverage tasks",
      "dependencies": [
        "x-cov:gen",
        "x-cov:view"
      ]
    },
    "x-cov:gen": {
      "description": "DEPENDENCY! Generate lcov coverage report",
      "command": "deno task x-cov:analyze --lcov --output=artifacts/cov.lcov"
    },
    "x-cov:view": {
      "description": "DEPENDENCY! View coverage report in HTML",
      "command": "deno task x-cov:analyze --html"
    },
    "x-cov:analyze": {
      "description": "DEPENDENCY! Analyze code coverage",
      "command": "deno coverage --exclude=\"(test|spec)\\.(js|mjs|ts|jsx|tsx)$\" artifacts/coverage/"
    },
    "lint": {
      "description": "Run all linters",
      "dependencies": [
        "x-lint:code",
        "x-lint:exports",
        "x-lint:copyright",
        "x-lint:clean"
      ]
    },
    "x-lint:code": {
      "description": "DEPENDENCY! Lint code",
      "command": "deno lint --config ./deno.json"
    },
    "x-lint:exports": {
      "description": "DEPENDENCY! Lint export statements",
      "command": "deno run --allow-read ./.build/export_star_check.ts"
    },
    "x-lint:copyright": {
      "description": "DEPENDENCY! Lint copyright headers",
      "command": "deno run --allow-read --allow-write ./.build/copyright_files.ts"
    },
    "x-lint:clean": {
      "description": "DEPENDENCY! Clean linting artifacts",
      "command": "deno run --allow-read --allow-write ./.build/clean_files.ts"
    },
    "docs": {
      "description": "Generate documentation for all packages",
      "dependencies": [
        "x-docs:internal",
        "x-docs:testing",
        "x-docs:utils",
        "x-docs:x"
      ]
    },
    "x-docs:internal": {
      "description": "DEPENDENCY! Generate documentation for internal package",
      "command": "deno doc --html --lint --output=artifacts/docs/internal --name='@kz/internal' ./internal/*/mod.ts"
    },
    "x-docs:testing": {
      "description": "DEPENDENCY! Generate documentation for testing package",
      "command": "deno doc --html --lint --output=artifacts/docs/testing --name='@kz/testing' ./testing/*/mod.ts"
    },
    "x-docs:utils": {
      "description": "DEPENDENCY! Generate documentation for utils package",
      "command": "deno doc --html --lint --output=artifacts/docs/utils --name='@kz/utils' ./utils/*/mod.ts"
    },
    "x-docs:x": {
      "description": "DEPENDENCY! Build docs index",
      "command": "deno run --allow-read --allow-write ./.build/build_docs_index.ts"
    },
    "test": {
      "description": "Run tests and coverage for all packages including docs",
      "command": "deno test '**/*.test.ts' '**/*.spec.ts' --allow-all --doc --coverage=coverage --trace-leaks --clean"
    },
    "checks": {
      "description": "Run all checks for all packages",
      "dependencies": [
        "lint",
        "fmt",
        "test",
        "cov"
      ]
    },
    "fmt": {
      "description": "Run formatter for all packages",
      "command": "deno fmt && deno fmt --check"
    },
    "y-pre-commit": {
      "description": "FUTURE! Will replace the pre-commit once code features are in place. Run pre-commit checks",
      "dependencies": [
        "checks",
        "docs",
        "x-publish-test"
      ]
    },
    "pre-commit": {
      "description": "TEMP! Will be replaced once code features are in place. Run pre-commit checks.",
      "dependencies": [
        "z-checks",
        "docs",
        "x-publish-test"
      ]
    },
    "z-test": {
      "description": "TEMP! Will be removed once code features are in place. Run tests for all packages including docs without coverage.",
      "command": "deno test --allow-all --doc --trace-leaks --clean"
    },
    "z-checks": {
      "description": "TEMP! Will be removed once code features are in place. Run all checks for all packages without coverage.",
      "dependencies": [
        "lint",
        "fmt",
        "test"
      ]
    },
    "x-publish-test": {
      "description": "DEPENDENCY! Run publish test.",
      "command": "deno publish --dry-run --allow-dirty"
    }
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "ban-untagged-todo",
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "no-throw-literal",
        "verbatim-module-syntax",
        "prefer-ascii",
        "no-undef",
        "no-sync-fn-in-async-fn",
        "no-sparse-arrays",
        "no-self-compare",
        "no-non-null-assertion",
        "no-non-null-asserted-optional-chain",
        "no-external-import",
        "no-eval",
        "no-const-assign",
        "no-boolean-literal-for-arguments",
        "no-await-in-loop",
        "guard-for-in",
        "explicit-module-boundary-types"
      ]
    }
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 80,
    "proseWrap": "preserve",
    "useTabs": false,
    "singleQuote": true,
    "semiColons": true
  },
  "exclude": [
    ".git",
    "cov",
    "coverage",
    "docs"
  ],
  "publish": {
    "include": [
      "README.md",
      "LICENSE",
      "**/*.ts",
      "deno.json",
      "deno.lock",
      "**/*.json"
    ],
    "exclude": [
      "**/*.test.ts"
    ]
  }
}
